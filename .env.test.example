# Test-database connection string for Phase 2b integration tests.
# Defaults match docker-compose.yml's postgres-test service — copy this
# file to .env.test (gitignored) if you need to override.
#
# The variable is DATABASE_URL (not TEST_DATABASE_URL) because Prisma's
# CLI reads DATABASE_URL by convention; dotenv-cli scopes it to the
# `db:test:migrate` invocation so it doesn't leak to the shell or to
# `prisma migrate dev` which still uses .env for the real dev DB.
# The test harness (src/lib/testing/prismaTestClient.ts) also loads
# this file with override:true and refuses to run against anything
# that doesn't look local, so a stray .env DATABASE_URL can't sneak
# a production URL into the test run.
DATABASE_URL=postgresql://test:test@localhost:5433/test?schema=public
