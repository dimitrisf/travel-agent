OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# ─── Auth (Stage 17 Phase 1) ──────────────────────────────────────────
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_GOOGLE_ID / SECRET come from https://console.cloud.google.com/apis/credentials
AUTH_SECRET=replace-with-random-32-byte-base64
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
