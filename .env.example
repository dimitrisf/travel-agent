OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# ─── Auth (Stage 17 Phase 1) ──────────────────────────────────────────
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_GOOGLE_ID / SECRET come from https://console.cloud.google.com/apis/credentials
AUTH_SECRET=replace-with-random-32-byte-base64
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# ─── Weather source (Stage 20) ────────────────────────────────────────
# USE_SEEDED_WEATHER controls which WeatherRepository implementation
# createWeatherService instantiates:
#   - "1" (default, or unset) — SeededWeatherRepository. Reads the Neon
#     tables the demo library populates. Deterministic — required for
#     evals and CI. This is the safest default; fresh installs work
#     without an OWM key.
#   - "0" — LiveWeatherRepository. Fetches real conditions + forecasts
#     from OpenWeatherMap. Requires OPENWEATHERMAP_API_KEY below.
#     Coverage: current weather + up to 5-day daily forecast for
#     Athens, Berlin, London, Tokyo, New York (aggregated from the free
#     tier's 3-hour intervals). In-memory TTL cache (5 min current,
#     1 hr forecast) keeps well under the free-tier 60/min rate limit.
USE_SEEDED_WEATHER=1
# Free tier signup: https://openweathermap.org/api — no card required.
# Newly-created keys can take up to a few hours to activate.
OPENWEATHERMAP_API_KEY=replace-with-openweathermap-key
