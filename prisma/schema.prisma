generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// Geography
// ───────────────────────────────────────────────

model Country {
  id      Int    @id @default(autoincrement())
  name    String
  isoCode String @unique
  cities  City[]
}

model City {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  countryId      Int
  country        Country         @relation(fields: [countryId], references: [id])
  currentWeather CurrentWeather?
  forecasts      Forecast[]
  airports       Airport[]
  hotels         Hotel[]
}

// ───────────────────────────────────────────────
// Weather
// ───────────────────────────────────────────────

model Conditions {
  id             Int              @id @default(autoincrement())
  description    String           @unique
  currentWeather CurrentWeather[]
  forecasts      Forecast[]
}

model CurrentWeather {
  id           Int        @id @default(autoincrement())
  cityId       Int        @unique
  city         City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tempC        Float
  conditionsId Int
  conditions   Conditions @relation(fields: [conditionsId], references: [id])
}

model Forecast {
  id           Int        @id @default(autoincrement())
  cityId       Int
  city         City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  tempCMin     Float
  tempCMax     Float
  conditionsId Int
  conditions   Conditions @relation(fields: [conditionsId], references: [id])

  @@unique([cityId, date])
  @@index([cityId, date])
}

// ───────────────────────────────────────────────
// Travel — flights
// ───────────────────────────────────────────────

model Airport {
  id        Int    @id @default(autoincrement())
  iataCode  String @unique
  icaoCode  String @unique
  name      String
  cityId    Int
  city      City   @relation(fields: [cityId], references: [id])
  latitude  Float
  longitude Float
  timezone  String

  originOf      FlightDefinition[] @relation("FlightOrigin")
  destinationOf FlightDefinition[] @relation("FlightDestination")
}

model Airline {
  id                Int                @id @default(autoincrement())
  iataCode          String             @unique
  icaoCode          String             @unique
  name              String
  flightDefinitions FlightDefinition[]
}

model FlightDefinition {
  id                   Int              @id @default(autoincrement())
  airlineId            Int
  airline              Airline          @relation(fields: [airlineId], references: [id])
  flightNumber         String
  originAirportId      Int
  originAirport        Airport          @relation("FlightOrigin", fields: [originAirportId], references: [id])
  destinationAirportId Int
  destinationAirport   Airport          @relation("FlightDestination", fields: [destinationAirportId], references: [id])
  basePriceEUR         Float
  durationMinutes      Int
  stops                Int              @default(0)
  instances            FlightInstance[]

  @@unique([airlineId, flightNumber])
}

model FlightInstance {
  id                 Int              @id @default(autoincrement())
  flightDefinitionId Int
  flightDefinition   FlightDefinition @relation(fields: [flightDefinitionId], references: [id], onDelete: Cascade)
  departureDatetime  DateTime
  arrivalDatetime    DateTime
  status             String           @default("scheduled")
  aircraft           String?
  gate               String?
  seatsAvailable     Int              @default(180)

  flightBookings FlightBooking[]

  @@unique([flightDefinitionId, departureDatetime])
  @@index([departureDatetime])
}

// ───────────────────────────────────────────────
// Travel — hotels
// ───────────────────────────────────────────────

model Hotel {
  id        Int    @id @default(autoincrement())
  name      String
  cityId    Int
  city      City   @relation(fields: [cityId], references: [id])
  address   String
  stars     Int
  rating    Float
  latitude  Float
  longitude Float

  roomTypes          RoomType[]
  hotelAmenities     HotelAmenity[]
  cancellationPolicy CancellationPolicy?

  @@unique([cityId, name])
  @@index([cityId])
}

model RoomType {
  id        Int    @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  maxGuests Int
  beds      Int
  basePrice Float
  currency  String @default("EUR")

  availability  Availability[]
  hotelBookings HotelBooking[]

  @@unique([hotelId, name])
}

model Availability {
  id             Int      @id @default(autoincrement())
  roomTypeId     Int
  roomType       RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  roomsAvailable Int
  price          Float
  currency       String   @default("EUR")

  @@unique([roomTypeId, date])
  @@index([date])
}

model Amenity {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  hotelAmenities HotelAmenity[]
}

model HotelAmenity {
  hotelId   Int
  amenityId Int
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model CancellationPolicy {
  id               Int     @id @default(autoincrement())
  hotelId          Int     @unique
  hotel            Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  freeCancellation Boolean
  description      String
}

// ───────────────────────────────────────────────
// Travel — bookings (Stage 8)
// ───────────────────────────────────────────────

// A booking is a trip-level container. It groups one or more flight legs and
// zero or more hotel stays (or vice versa) into a single unit that transitions
// through a state machine (PROPOSED → CONFIRMED/PAID → CANCELLED/FAILED).
//
// Two keys of note:
//   - `reference`      : human-facing ID shown in the UI ("BKG-2026-A9F3K2").
//   - `idempotencyKey` : agent-generated UUID that lets the propose_booking tool
//                        be retried safely — a repeat call with the same key
//                        returns the existing row instead of creating a new one.
model Booking {
  id             Int           @id @default(autoincrement())
  reference      String        @unique
  idempotencyKey String        @unique
  status         BookingStatus @default(PROPOSED)

  // Ownership (Stage 17 Phase 2). Nullable because anonymous users can create
  // PROPOSED bookings without signing in — the row gets an owner only when
  // someone signs in and clicks Confirm (the Confirm route atomically sets
  // userId + customerName + customerEmail from the session and transitions
  // to CONFIRMED/PAID). Once past PROPOSED, userId is always set — enforced
  // in application code (BookingService.confirmBooking) rather than a
  // Postgres CHECK constraint to keep the migration path simple.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Denormalized customer info — nullable because anon PROPOSED rows have no
  // known customer until Confirm claims them. For signed-in flows, the
  // Confirm route fills these from the session (session.email / session.name).
  // Concrete scenarios where the denormalization matters
  // User changes their email (job change, moves to a personal account) — the flight booking they made last month was sent to airlines with the OLD email. If BookingCard renders from User.email, past bookings retroactively show the new email as if that's what was on the reservation. Wrong.
  // User changes their name (marriage, typo fix, legal change) — flights are tied to a specific passenger name printed on the ticket. Displaying the current User.name on a past booking is misleading; the reservation was made under the previous name.
  // User account deletion (GDPR right to erasure, or just "delete my account") — our Booking.user relation is onDelete: SetNull, meaning if the User row is deleted, booking.userId becomes NULL. Without denormalized customerName/Email, the past booking loses its identity entirely. With them, the historical record survives (which is often a legal/audit requirement).
  // Third-party manifest — real airlines/hotels get sent name+email at booking time. The record should reflect what was actually sent, not what the profile currently says.
  customerName  String?
  customerEmail String?

  totalPriceEUR Float
  currency      String @default("EUR")

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  flightBookings FlightBooking[]
  hotelBookings  HotelBooking[]
  payments       Payment[]

  @@index([status, createdAt])
  @@index([userId])
}

enum BookingStatus {
  PROPOSED
  CONFIRMED
  PAID
  CANCELLED
  FAILED
}

// One row per flight leg. A round-trip has two FlightBooking rows; a one-way
// has one. `pricePerSeatEUR` is frozen at booking time so past bookings never
// change if the pricing rules do.
model FlightBooking {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  flightInstanceId Int
  flightInstance   FlightInstance @relation(fields: [flightInstanceId], references: [id])

  cabinClass      String
  adults          Int    @default(1)
  children        Int    @default(0)
  seats           Int
  pricePerSeatEUR Float
  totalPriceEUR   Float

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([flightInstanceId])
}

// One row per hotel stay. Nights is stored explicitly for convenience even
// though it's derivable from (checkoutDate - checkinDate).
model HotelBooking {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  roomTypeId Int
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  checkinDate   DateTime @db.Date
  checkoutDate  DateTime @db.Date
  nights        Int
  guests        Int      @default(2)
  rooms         Int      @default(1)
  totalPriceEUR Float

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([roomTypeId, checkinDate])
}

// Stub payment table — provider defaults to "stub" and every attempt succeeds.
// When real Stripe integration lands, provider becomes "stripe" and providerRef
// holds the PaymentIntent ID; this table's shape is already ready.
model Payment {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount      Float
  currency    String        @default("EUR")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("stub")
  providerRef String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([bookingId, status])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ───────────────────────────────────────────────
// Auth (Stage 17 Phase 1)
// ───────────────────────────────────────────────
// Tables owned by Auth.js (NextAuth v5) via @auth/prisma-adapter. Shapes come
// straight from the official adapter reference — do not rename columns or
// change types, or the adapter will silently break at runtime (adapter reads
// via Prisma's typed API but expects these exact field names).
//
// Session strategy is "database" (not JWT): a Session row is written per
// active login and read on every request that calls auth(). Costs one DB
// round-trip per request; buys the ability to invalidate a session server-
// side (delete the row) and to see who's currently logged in.
//
// User.id uses cuid — NextAuth's convention. All app-side FKs to User must
// therefore also be String, not Int (relevant for Booking.userId in Phase 2).

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  conversations Conversation[]
}

// Account is one row per OAuth provider per user. A user can have multiple
// accounts (e.g., Google + GitHub). The adapter uses the provider + providerAccountId composite as the primary key, so that a user cannot have two accounts with the same provider.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// Session is one row per active login. The adapter reads this table on every request to determine if the session is valid. The sessionToken is a random string that is stored in a cookie on the client and used to look up the session in the database. The expires field is a timestamp that indicates when the session will expire. The adapter automatically deletes expired sessions from the database.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// VerificationToken is required by the Prisma adapter even when only OAuth
// providers are configured — the adapter's code paths reference it. Kept as
// an empty table for now; magic-link support (if ever added) uses it.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ───────────────────────────────────────────────
// Conversations (Stage 17 Phase 3)
// ───────────────────────────────────────────────
// Persistence for signed-in users' chat sessions. Anonymous users continue
// to run tab-scoped without writing to these tables — the /api/agent route
// only creates a Conversation when the request carries a valid session.
//
// Model choice: one Message row per AgentInputItem (user turn, assistant
// turn, function_call, function_call_result). The AgentInputItem is a
// discriminated union with wildly different shapes per role, so `data` is
// stored as a JSON blob — normalizing every field would be a schema for
// one library's internal format. Loading is `SELECT * WHERE
// conversationId = ? ORDER BY createdAt ASC` — the resulting array is
// what the agent's run() expects verbatim.

model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable — derived from the first user message on first turn, may be
  // updated later (LLM summarization is future work). Kept short (~60 chars)
  // for the conversations dropdown UI.
  title String?

  // Sharing (Stage 17 Phase 4). Default is private (owner-only view).
  // When true, anyone with the /c/[id] URL — signed-in or anonymous — can
  // view the full history read-only. Owner keeps write access; nobody
  // else can append turns. Toggle back to false to invalidate the link.
  shared Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Full AgentInputItem serialized as JSON. Shape depends on the item type:
  //   user turn:              { role: 'user', content: string }
  //   assistant turn:         { role: 'assistant', content: [...] }
  //   tool call:              { type: 'function_call', name, arguments, callId }
  //   tool call result:       { type: 'function_call_result', callId, output }
  // Consumers must parse and dispatch by shape — Prisma can't type this any
  // further without a real generic-Json variant.
  data Json

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
